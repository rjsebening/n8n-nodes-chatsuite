{
	"name": "n8n-nodes-chatsuite",
	"version": "0.1.1",
	"description": "Connect n8n with the ChatSuite Tenant API - customers, tickets, knowledge base, WhatsApp messaging and webhooks",
	"type": "commonjs",
	"keywords": [
		"n8n-community-node-package",
		"chatsuite",
		"whatsapp",
		"tickets",
		"crm"
	],
	"license": "MIT",
	"homepage": "https://github.com/rjsebening/n8n-nodes-chatsuite#readme",
	"author": {
		"name": "Rezk Jörg Sebening",
		"email": "dev@joerg-sebening.com"
	},
	"bugs": {
		"url": "https://github.com/rjsebening/n8n-nodes-chatsuite/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/rjsebening/n8n-nodes-chatsuite.git"
	},
	"engines": {
		"node": ">=20.15"
	},
	"scripts": {
		"build": "npx rimraf dist && tsc && gulp build:icons",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"format": "prettier nodes credentials --write",
		"lint": "eslint nodes credentials package.json",
		"lint:fix": "eslint nodes credentials package.json --fix",
		"lint:node": "n8n-node lint",
		"lint:all": "npm run lint && npm run lint:node",
		"lint:scan": "node scripts/scan-local.mjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/**/*.map",
		"!dist/tsconfig.tsbuildinfo",
		"README.md",
		"LICENSE.md"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ChatSuiteApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/ChatSuite/ChatSuite.node.js",
			"dist/nodes/ChatSuite/triggers/ChatSuiteTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@types/node": "^24.10.1",
		"eslint": "9.32.0",
		"gulp": "^5.0.1",
		"gulp-cli": "^3.1.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"rimraf": "^6.1.3",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
